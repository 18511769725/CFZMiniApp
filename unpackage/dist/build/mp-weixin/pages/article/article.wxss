page{height:100%;background:#020713}.article-page{height:100vh;color:#eaf1fb;background:#020713}.article-scroll{height:100%;box-sizing:border-box}.article-content{padding:42rpx 34rpx 64rpx}.article-title{display:block;margin-bottom:14rpx;color:#fff;font-size:44rpx;font-weight:700;line-height:1.45;text-align:center;word-break:break-word}.article-createdate{display:block;margin-bottom:30rpx;color:#8fa1ba;font-size:26rpx;line-height:1.4;text-align:right}.article-blocks{display:flex;flex-direction:column;gap:24rpx}.article-block{width:100%}.article-text-block{display:block;color:#d4dfef;font-size:29rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}.article-image{display:block;width:100%;height:auto;margin:0 auto}.article-video{display:block;width:100%;height:420rpx;margin:0 auto;position:relative;overflow:hidden;background:#000}.article-video-player,.article-video-cover{width:100%;height:100%}.article-video-cover{display:flex;align-items:center;justify-content:center}.article-video-play-button{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;border:2rpx solid rgba(255,255,255,.85);border-radius:50%;background:rgba(0,0,0,.35)}.article-video-play-icon{width:0;height:0;margin-left:7rpx;border-top:17rpx solid transparent;border-bottom:17rpx solid transparent;border-left:25rpx solid #ffffff}.article-body{color:#d4dfef;font-size:29rpx;line-height:1.8;word-break:break-word}.article-message{padding:100rpx 32rpx;color:#aabbd2;font-size:28rpx;text-align:center}
