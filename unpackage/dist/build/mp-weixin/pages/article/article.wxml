<view class="article-page"><scroll-view class="article-scroll" scroll-y><view wx:if="{{a}}" class="article-message">正在加载文章...</view><view wx:elif="{{b}}" class="article-message">{{c}}</view><view wx:elif="{{d}}" class="article-content"><text class="article-title">{{e}}</text><text class="article-createdate">{{f}}</text><view class="article-blocks"><view wx:for="{{g}}" wx:for-item="block" wx:key="j" class="article-block"><text wx:if="{{block.a}}" class="article-text-block">{{block.b}}</text><image wx:elif="{{block.c}}" class="article-image" src="{{block.d}}" mode="widthFix" bindtap="{{block.e}}"/><view wx:elif="{{block.f}}" class="article-video"><video wx:if="{{block.g}}" class="article-video-player" src="{{block.h}}" controls autoplay object-fit="contain"/><view wx:else class="article-video-cover" bindtap="{{block.i}}"><view class="article-video-play-button"><view class="article-video-play-icon"></view></view></view></view></view></view></view><view wx:else class="article-content"><text class="article-title">{{h}}</text><rich-text class="article-body" nodes="{{i}}"/></view></scroll-view></view>