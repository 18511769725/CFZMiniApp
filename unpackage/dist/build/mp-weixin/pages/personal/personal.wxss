.container{min-height:100vh;background:url(https://mvpme82.cloud/data/9b82d795-9982-4e39-aa73-2138868cf6b3_1774399232772.jpg) no-repeat top center,linear-gradient(180deg,#0a1931,#162a4d);background-size:100% auto,auto;padding:20rpx 30rpx;color:#fff}.header-title{text-align:center;font-size:34rpx;padding:40rpx 0}.section-title{font-size:32rpx;margin:30rpx 0 20rpx;font-weight:700}.card{background:rgba(255,255,255,.1);border-radius:20rpx;padding:30rpx;border:1px solid rgba(255,255,255,.1);margin-bottom:20rpx}.company-card{margin-top:40rpx;background:rgba(49,69,107,.73);border:1px solid rgba(255,255,255,.2)}.company-card .company-header{display:flex;justify-content:space-between;align-items:center}.company-card .company-header .company-name{font-size:32rpx;font-weight:400}.company-card .company-header .enterprise-tag{display:flex;align-items:center;justify-content:center;min-width:94rpx;min-height:40rpx;padding:0;background:transparent;border-radius:0}.company-card .company-header .enterprise-tag-icon{width:150rpx;height:50rpx;object-fit:contain}.company-card .divider{height:2rpx;background-color:rgba(255,255,255,.2);margin:20rpx 0}.company-card .code{font-size:24rpx;color:#b0adad;margin:10rpx 0 30rpx}.company-card .info-grid{display:flex;flex-direction:column;justify-content:flex-start}.company-card .info-grid .info-line{width:100%;display:flex;flex-direction:row;justify-content:flex-start}.company-card .info-grid .info-line .info-item{width:50%;margin-bottom:15rpx;display:flex;align-items:center}.company-card .info-grid .info-line .info-item .label{font-size:22rpx;color:#e6e7e7;background-color:#3e5b8a;padding:4rpx 10rpx;border-radius:4rpx;width:120rpx;text-align:center;flex-shrink:0}.company-card .info-grid .info-line .info-item .val{font-size:26rpx;margin-left:12rpx}.account-card{display:flex;align-items:center;background-image:url(https://mvpme82.cloud/data/0230c28f-a692-40b0-b5d8-7ab5b7a824ae_1774405848969.jpg);background-size:cover;background-position:center;background-repeat:no-repeat;padding:20rpx;border-radius:20rpx}.account-card .avatar{width:100rpx;height:100rpx;border-radius:50%;background:#eee;margin-left:20rpx}.account-card .account-detail{margin-left:20rpx}.account-card .account-detail .name-row{display:flex;flex-direction:column}.account-card .account-detail .name-row .name{font-size:32rpx;font-weight:700;margin-right:15rpx}.account-card .account-detail .name-row .role{font-size:24rpx;color:#ccc;margin-top:15rpx}.account-card .account-detail .contact-row{font-size:22rpx;color:#f7f6f6;margin-top:15rpx;display:flex;align-items:center}.account-card .account-detail .contact-row .contact-item{display:flex;align-items:center;gap:6rpx}.account-card .account-detail .contact-row .contact-icon{width:25rpx;height:25rpx}.stats-grid{display:flex;justify-content:space-between;margin-bottom:20rpx}.stats-grid .stat-box{background:rgba(255,255,255,.05);width:31%;height:140rpx;border-radius:15rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border:2rpx solid #d4af37}.stats-grid .stat-box .stat-label{font-size:24rpx;color:#b7ab93}.stats-grid .stat-box .stat-divider{width:80%;height:2rpx;background-color:#b7ab93;margin:10rpx 0;border-radius:1rpx}.stats-grid .stat-box .stat-count{font-size:40rpx;font-weight:700;margin-top:10rpx;color:#4dbd71}.tab-scroll{flex-shrink:0;background:rgba(0,0,0,0);width:100%;text-align:center;padding:20rpx 0}.tab-container{width:90%;display:flex;flex-direction:row;justify-content:space-between;gap:10rpx;padding:10rpx 15rpx;border:3rpx solid #d4a574;border-radius:50rpx;background-color:#3d597e}.tab-container .tab-item{flex:1;text-align:center;padding:16rpx 0;border-radius:50rpx;color:rgba(255,255,255,.96);font-size:32rpx;white-space:nowrap;transition:all .3s ease}.tab-container .tab-item.active{background:linear-gradient(135deg,#f3cb9f,#c9945f);border:2rpx solid #e98a24;color:#1a3a52;font-weight:600}.tab-container .tab-item:active{opacity:.8}.order-content{display:flex;gap:20rpx}.order-content .order-img{width:160rpx;height:160rpx;border-radius:10rpx}.order-content .order-info{flex:1;font-size:22rpx}.order-content .order-info .order-row{margin-bottom:8rpx;color:#ccc}.order-content .order-info .status{color:#88b0ff}.order-content .order-info .detail-btn{margin-top:10rpx;float:right;font-size:20rpx;padding:0 20rpx;height:44rpx;line-height:44rpx;background:transparent;border:1px solid #556b8d;color:#fff;border-radius:22rpx}.function-card{display:flex;justify-content:space-around;padding:40rpx 0}.function-card .fn-item{display:flex;flex-direction:column;align-items:center;font-size:24rpx}.function-card .fn-item .fn-icon{font-size:40rpx;margin-bottom:15rpx}
