<view class="container"><view class="card company-card"><view class="company-header"><text class="company-name">{{a}}</text><view class="enterprise-tag"><image wx:if="{{b}}" class="enterprise-tag-icon" src="{{c}}" mode="aspectFit"></image></view></view><view class="code">统一社会信用代码：{{d}}</view><view class="divider"></view><view class="info-grid"><view class="info-line"><view class="info-item"><view class="label"><text>企业联系人</text></view><text class="val">{{e}}</text></view><view class="info-item"><view class="label"><text>手机号码</text></view><text class="val">{{f}}</text></view></view><view class="info-line"><view class="info-item" style="width:100%"><view class="label"><text>职位信息</text></view><text class="val">{{g}}</text></view></view></view></view><view class="section-title">当前账户信息</view><view class="card account-card"><image class="avatar" src="{{h}}" mode="aspectFill"></image><view class="account-detail"><view class="name-row"><text class="name">{{i}}</text><text class="role">{{j}}</text></view><view class="contact-row"><view class="contact-item"><image class="contact-icon" src="{{k}}" mode="aspectFit"/><text>{{l}}</text></view><view class="contact-item" style="margin-left:30rpx"><image class="contact-icon" src="{{m}}" mode="aspectFit"/><text>{{n}}</text></view></view></view></view><view class="section-title">服务清单</view><view class="card order-card"><view class="stats-grid"><view class="stat-box"><text class="stat-label">服务中</text><view class="stat-divider"></view><text class="stat-count" style="color:#fdcf82">{{o}}</text></view><view class="stat-box"><text class="stat-label">服务完成</text><view class="stat-divider"></view><text class="stat-count" style="color:#74bea0">{{p}}</text></view><view class="stat-box"><text class="stat-label">已终止</text><view class="stat-divider"></view><text class="stat-count" style="color:#d27374">{{q}}</text></view></view><scroll-view scroll-x class="tab-scroll" show-scrollbar="false"><view class="tab-container"><view wx:for="{{r}}" wx:for-item="tab" wx:key="b" class="{{['tab-item', tab.c && 'active']}}" bindtap="{{tab.d}}">{{tab.a}}</view></view></scroll-view><view class="order-content"><image class="order-img" src="{{s}}" mode="aspectFill"></image><view class="order-info"><view class="order-row">订单编号：{{t}}</view><view class="order-row">服务类型：{{v}}</view><view class="order-row status">进度状态：{{w}}</view><button class="detail-btn">查看详情</button></view></view></view><view class="section-title">我的功能</view><view class="card function-card"><view wx:for="{{x}}" wx:for-item="fn" wx:key="b" class="fn-item"><view class="fn-icon">📍</view> <text>{{fn.a}}</text></view></view></view>