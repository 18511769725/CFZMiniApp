<view class="main-page"><view class="header-bg"><image class="bg-placeholder" src="{{a}}" mode="aspectFill"></image><view class="platform-title"><text class="title-cn">朝阳企业服务平台</text><text class="title-en">Chaoyang Enterprise Service Platform</text></view></view><view class="enterprise-card"><view class="enterprise-info"><text class="enterprise-name">{{b}}</text><text class="enterprise-tag">{{c}}</text></view><view style="height:4rpx;background-color:rgba(255, 255, 255, 0.2);margin:20rpx 0"></view><view class="quota-overview"><text class="quota-title">配额配置情况与当前使用进度</text><view class="overview-grid"><view class="overview-item"><text class="overview-label">益企•安居</text><text class="overview-value">{{d}}</text></view><view class="overview-item"><text class="overview-label">益企•悦享</text><text class="overview-value">{{e}}</text></view><view class="overview-item"><text class="overview-label">益企•康护</text><text class="overview-value">{{f}}</text></view></view></view></view><view class="module module-anju"><image class="module-anju-bg" src="{{g}}" mode="aspectFill"></image><view class="module-anju-gradient"></view><view class="module-header"><text class="module-title">益企·安居</text><text class="module-tag">{{h}}</text></view><text class="module-subtitle">住房保障助企安居无忧</text><view style="height:4rpx;background-color:rgba(255, 255, 255, 0.4);margin:20rpx 0"></view><block wx:if="{{i}}"><view wx:for="{{j}}" wx:for-item="item" wx:key="f" class="section"><view class="section-header"><text class="section-title">{{item.a}}</text><text class="section-tip">{{item.b}}</text></view><view class="data-row"><view class="data-item"><text class="data-label">支持人数</text><text class="data-value">{{item.c}}</text></view><view class="data-item"><text class="data-label">已使用</text><text class="data-value used">{{item.d}}</text></view><view class="data-item"><text class="data-label">可使用</text><text class="data-value available">{{item.e}}</text></view></view></view></block><view wx:else class="quota-empty-text">暂无安居配额配置</view></view><view class="module module-yuexiang"><image class="module-yuexiang-bg" src="{{k}}" mode="aspectFill"></image><view class="module-yuexiang-gradient"></view><view class="module-header"><text class="module-title">益企·悦享</text><text class="module-tag">{{l}}</text></view><text class="module-subtitle">专属积分悦享朝阳商务资源</text><view style="height:4rpx;background-color:rgba(255, 255, 255, 0.2);margin:20rpx 0"></view><view class="section"><text class="section-title">额度总览</text><view class="data-row"><view class="data-item"><text class="data-label">总额度</text><text class="data-value">{{m}}</text></view><view class="data-item"><text class="data-label">已使用</text><text class="data-value used">{{n}}</text></view><view class="data-item"><text class="data-label">剩余可用</text><text class="data-value">{{o}}</text></view></view></view></view><view class="module module-kanghu"><image class="module-kanghu-bg" src="{{p}}" mode="aspectFill"></image><view class="module-kanghu-gradient"></view><view class="module-header"><text class="module-title">益企·康护</text><text class="{{['quota-section-status', r]}}">{{q}}</text></view><text class="module-subtitle">可选套餐全心护航健康</text><view style="height:4rpx;background-color:rgba(255, 255, 255, 0.2);margin:20rpx 0"></view><view class="section"><text class="section-title">服务套餐</text><view class="data-row"><view class="data-item"><text class="data-label">单人额度</text><text class="data-value">{{s}}</text></view><view class="data-item"><text class="data-label">支持人数</text><text class="data-value">{{t}}</text></view><view class="data-item"><text class="data-label">使用状态</text><text class="{{['quota-metric-value', w]}}">{{v}}</text></view></view></view></view></view>