.main-page{background-color:#0a1a3a;min-height:100vh;color:#fff;padding-bottom:30rpx}.header-bg{position:relative;padding:40rpx 30rpx 20rpx;height:460rpx}.bg-placeholder{position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;opacity:.3}.platform-title{text-align:center;margin-bottom:30rpx;position:relative;z-index:1;margin-top:140rpx}.title-cn{display:block;font-size:48rpx;font-weight:500}.title-en{display:block;font-size:28rpx;opacity:.8;margin-top:8rpx}.enterprise-card{background:rgba(255,255,255,.1);border-radius:20rpx;padding:30rpx;-webkit-backdrop-filter:blur(10rpx);backdrop-filter:blur(10rpx);position:relative;z-index:1;margin:-60rpx 30rpx 20rpx;border:1rpx solid rgba(255,255,255,.3);box-shadow:0 0 4rpx rgba(255,255,255,.6),0 0 12rpx rgba(190,210,255,.35),0 0 24rpx rgba(170,190,255,.2)}.enterprise-info{display:flex;align-items:center;justify-content:space-between;margin-bottom:10rpx}.enterprise-name{font-size:36rpx;font-weight:500}.enterprise-tag{font-size:24rpx;padding:6rpx 16rpx;background:rgba(100,149,237,.3);border-radius:20rpx}.enterprise-desc{font-size:28rpx;opacity:.7;margin-bottom:24rpx}.overview-grid{position:relative;z-index:2;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin-bottom:20rpx;margin-top:15rpx}.overview-item{background:linear-gradient(180deg,rgba(18,47,77,.18),rgba(24,54,88,.12));border:1rpx solid rgba(212,228,245,.16);border-radius:18rpx;padding:16rpx 18rpx;display:flex;flex-direction:column;gap:20rpx}.overview-label{text-align:center;font-size:21rpx;color:rgba(219,236,255,.82);position:relative}.overview-label:after{content:"";position:absolute;bottom:-12rpx;left:50%;transform:translate(-50%);width:80%;height:2rpx;background-color:rgba(255,255,255,.3);border-radius:1rpx}.overview-value{display:flex;flex:1;justify-content:center;align-items:center;text-align:center;font-size:28rpx;font-weight:600;color:#fff;text-shadow:0 2rpx 4rpx rgba(6,20,46,.52)}.quota-title{font-size:28rpx;opacity:.8;margin-bottom:20rpx}.quota-items{display:flex;justify-content:space-between}.quota-item{flex:1;text-align:center}.quota-label{font-size:26rpx;opacity:.9;display:block;margin-bottom:12rpx}.quota-desc{font-size:28rpx;display:block;line-height:1.5}.quota-value{font-size:36rpx;font-weight:500}.quota-unit{font-size:24rpx;opacity:.8}.module{margin:20rpx 30rpx;border-radius:20rpx;padding:30rpx;position:relative;overflow:hidden}.module-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx}.module-title{font-size:40rpx;font-weight:500}.module-tag{font-size:24rpx;padding:6rpx 16rpx;border-radius:20rpx}.module-subtitle{font-size:28rpx;opacity:.8;margin-bottom:24rpx}.section{margin-bottom:24rpx}.section:last-child{margin-bottom:0}.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}.section-title{font-size:32rpx}.section-tip{font-size:24rpx;opacity:.7}.data-row{display:flex;background:rgba(255,255,255,.1);border-radius:16rpx;padding:20rpx}.data-item{flex:1;text-align:center}.data-item:not(:last-child){border-right:1px solid rgba(255,255,255,.2)}.data-label{font-size:24rpx;opacity:.7;display:block;margin-bottom:8rpx}.data-value{font-size:36rpx;font-weight:500}.data-value.used{color:#e6a8b8}.data-value.available{color:#87e8de}.module-anju{background:linear-gradient(135deg,rgba(65,105,225,.3),rgba(30,144,255,.2));z-index:1}.module-anju-bg{position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;opacity:.4}.module-anju-gradient{position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(65,105,225,.1),rgba(30,144,255,.1),rgba(21,60,94,.9));z-index:1}.module-anju .module-header,.module-anju .module-subtitle,.module-anju .section{position:relative;z-index:2}.module-anju .module-tag{background:rgba(30,144,255,.4)}.module-yuexiang{background:linear-gradient(135deg,rgba(139,69,19,.3),rgba(205,133,63,.2));position:relative;z-index:1}.module-yuexiang-bg{position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;opacity:.4}.module-yuexiang-gradient{position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(139,69,19,.1),rgba(205,133,63,.1),#28153a);z-index:1}.module-yuexiang .module-header,.module-yuexiang .module-subtitle,.module-yuexiang .section{position:relative;z-index:2}.module-yuexiang .module-tag{background:rgba(205,133,63,.4)}.module-kanghu{background:linear-gradient(135deg,rgba(72,209,204,.3),rgba(95,158,160,.2));position:relative;z-index:1;margin-bottom:50rpx}.module-kanghu-bg{position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;opacity:.4}.module-kanghu-gradient{position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(72,209,204,.1),rgba(95,158,160,.1),#082b34);z-index:1}.module-kanghu .module-header,.module-kanghu .module-subtitle,.module-kanghu .section{position:relative;z-index:2}.module-kanghu .module-tag{background:rgba(95,158,160,.4)}.quota-empty-text{font-size:24rpx;color:rgba(213,231,252,.88)}.quota-section-status{flex-shrink:0;min-width:110rpx;padding:8rpx 14rpx;border-radius:999rpx;font-size:21rpx;font-weight:600;text-align:center;color:var(--biz-primary);background:rgba(226,236,246,.92);border:1rpx solid rgba(190,207,224,.9)}.status-used{color:#9a3a00}.status-unused{color:#0b7f5c}.quota-metric-value{font-size:33rpx;font-weight:800;color:#fff;line-height:1.1;text-shadow:0 3rpx 8rpx rgba(6,22,48,.56)}.quota-metric-unit{margin-top:4rpx;font-size:20rpx;color:rgba(205,226,250,.82)}.quota-metric-value.warning{color:#ffdf9f}.quota-metric-value.success{color:#b8ffd9}
